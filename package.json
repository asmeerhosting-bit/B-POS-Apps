{
  "name": "b-pos",
  "version": "1.0.0",
  "description": "B-POS Windows app - BestTaup",
  "author": "BestTaup | Powered by ARM.Asmi | Srilanka Pottuvil",
  "main": "main.js",
  "scripts": { "start": "electron .", "build": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "lk.besttaup.bpos",
    "productName": "B-POS",
    "artifactName": "B-POS-Setup.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "config.json", "offline.html", "icon.ico", "package.json"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "B-POS" }
  }
}
